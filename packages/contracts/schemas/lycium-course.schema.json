{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lycium.dev/schemas/lycium-course.schema.json",
  "title": "Lycium Course Snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "modules"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "shortDescription": { "type": "string", "minLength": 1 },
    "difficultyLevel": { "type": "string" },
    "category": { "type": "string" },
    "department": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "learningTypes": { "type": "array", "items": { "type": "string" } },
    "estimatedMinutes": { "type": "number", "minimum": 0 },
    "estimatedHours": { "type": "number", "minimum": 0 },
    "orderMandatory": { "type": "boolean" },
    "sourceIds": { "type": "array", "items": { "type": "string" } },
    "sourceRecords": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "lycium-source-record.schema.json" } },
        { "type": "object", "additionalProperties": true }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pacingLabel": { "enum": ["Module", "Week"] },
        "generationReadiness": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "contractVersion": { "type": "string" },
            "status": { "type": "string" },
            "ready": { "type": "boolean" },
            "sourceEvidence": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "sourceUrlCount": { "type": "number", "minimum": 0 },
                "usableInputArtifactCount": { "type": "number", "minimum": 0 },
                "submittedEvidenceCount": { "type": "number", "minimum": 0 },
                "minimumCourseSources": { "type": "number", "minimum": 0 },
                "minimumSourceStrengthScore": { "type": "number", "minimum": 0 }
              }
            },
            "conceptCoverage": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "status": { "type": "string" },
                "coverageRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "minimumCoverageRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "requiredConceptCount": { "type": ["number", "null"], "minimum": 0 },
                "coveredConceptCount": { "type": ["number", "null"], "minimum": 0 },
                "uncoveredConcepts": { "type": "array", "items": { "type": "string" } },
                "coverageRows": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
              }
            },
            "sourceGate": {
              "type": ["object", "null"],
              "additionalProperties": true
            },
            "sourceStrength": {
              "type": ["object", "null"],
              "additionalProperties": true
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["message"],
                "properties": {
                  "code": { "type": "string" },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "sections"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "sourceIds": { "type": "array", "items": { "type": "string" } },
          "estimatedMinutes": { "type": "number", "minimum": 0 },
          "estimatedHours": { "type": "number", "minimum": 0 },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["id", "title", "pageType", "sectionType", "content"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "pageType": { "enum": ["learn", "apply"] },
                "sectionType": { "type": "string" },
                "sourceIds": { "type": "array", "items": { "type": "string" } },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "id": { "type": "string" },
                      "sourceId": { "type": "string" },
                      "source_id": { "type": ["string", "number"] },
                      "title": { "type": "string" },
                      "url": { "type": "string" },
                      "sourceIds": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "estimatedMinutes": { "type": "number", "minimum": 0 },
                "estimatedHours": { "type": "number", "minimum": 0 },
                "content": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["type"],
                    "properties": {
                      "type": { "type": "string" },
                      "title": { "type": "string" },
                      "value": { "type": "string" },
                      "url": { "type": "string" },
                      "src": { "type": "string" },
                      "imageUrl": { "type": "string" },
                      "alt": { "type": "string" },
                      "caption": { "type": "string" },
                      "credit": { "type": "string" },
                      "license": { "type": "string" },
                      "generatedBy": { "type": "string" },
                      "clip": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "startSeconds": { "type": ["number", "string"] },
                          "endSeconds": { "type": ["number", "string"] },
                          "start": { "type": ["number", "string"] },
                          "end": { "type": ["number", "string"] }
                        }
                      },
                      "startSeconds": { "type": ["number", "string"] },
                      "endSeconds": { "type": ["number", "string"] },
                      "start_seconds": { "type": ["number", "string"] },
                      "end_seconds": { "type": ["number", "string"] },
                      "sourceIds": { "type": "array", "items": { "type": "string" } },
                      "concepts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": true,
                          "required": ["name", "description"],
                          "properties": {
                            "name": { "type": "string", "minLength": 1 },
                            "description": { "type": "string", "minLength": 1 },
                            "sourceSectionId": { "type": "string" }
                          }
                        }
                      },
                      "questions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": true,
                          "required": ["question", "options", "answers"],
                          "properties": {
                            "question": { "type": "string", "minLength": 1 },
                            "options": {
                              "type": "array",
                              "minItems": 2,
                              "items": { "type": "string" }
                            },
                            "answers": {
                              "type": "array",
                              "items": { "type": "number" }
                            }
                          }
                        }
                      },
                      "questionBank": { "type": "array" },
                      "timed": { "type": ["boolean", "string"] },
                      "maxAttempts": { "type": ["number", "string", "null"] },
                      "timeLimit": { "type": ["number", "string", "null"] },
                      "passPercentage": { "type": ["number", "string", "null"] },
                      "showAnswers": { "type": ["boolean", "string"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
