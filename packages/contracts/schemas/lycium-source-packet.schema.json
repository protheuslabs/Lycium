{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protheuslabs.github.io/Lycium/schemas/lycium-source-packet.schema.json",
  "title": "Lycium Source Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "consumer",
    "context_id",
    "prompt",
    "source_urls",
    "corpus_run",
    "sources",
    "source_documents",
    "synthesis",
    "warnings",
    "quality"
  ],
  "properties": {
    "contract_version": { "const": "source-packet-v1" },
    "consumer": { "type": "string" },
    "context_id": { "type": "string" },
    "prompt": { "type": "string" },
    "source_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "corpus_run": { "$ref": "#/$defs/corpusRun" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/packetSource" }
    },
    "source_documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceDocument" }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quality": { "$ref": "#/$defs/packetQuality" }
  },
  "$defs": {
    "id": {
      "oneOf": [{ "type": "number" }, { "type": "string" }]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "indexedSource": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "canonical_url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "public_id": { "type": ["string", "null"] },
        "canonical_url": { "type": "string", "format": "uri" },
        "normalized_domain": { "type": "string" },
        "submitted_urls": { "type": "array", "items": { "type": "string" } },
        "title": { "type": ["string", "null"] },
        "source_type": { "type": "string" },
        "license": { "type": "string" },
        "is_free": { "type": "boolean" },
        "trust_baseline": { "type": "number" },
        "link_health": { "type": "string" },
        "archive_links": { "type": "array", "items": { "type": "string" } },
        "last_verified_at": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "source_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "public_id": { "type": ["string", "null"] },
        "source_id": { "$ref": "#/$defs/id" },
        "fetched_at": { "type": "string" },
        "status": { "type": "string" },
        "content_hash": { "type": ["string", "null"] },
        "content_type": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "text_digest": { "type": ["string", "null"] },
        "extracted_text": { "type": "string" },
        "raw_storage_ref": { "type": ["string", "null"] },
        "snapshot_metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "sourceDecision": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "decision"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "corpus_run_id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "consumer": { "type": "string" },
        "context_id": { "type": "string" },
        "original_url": { "type": "string" },
        "source_url": { "type": "string" },
        "decision": { "type": "string" },
        "relevance_score": { "type": "number" },
        "matched_terms": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": ["string", "null"] },
        "rationale": { "type": ["string", "null"] },
        "payload": { "$ref": "#/$defs/metadata" },
        "created_at": { "type": "string" }
      }
    },
    "sourceIndexRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["service"],
      "properties": {
        "service": { "type": "string" },
        "sourcePublicId": { "type": ["string", "null"] },
        "snapshotPublicId": { "type": ["string", "null"] },
        "sourceRemoteId": { "$ref": "#/$defs/id" },
        "snapshotRemoteId": { "$ref": "#/$defs/id" },
        "sourceLocalId": { "$ref": "#/$defs/id" },
        "snapshotLocalId": { "$ref": "#/$defs/id" }
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": true,
      "required": ["url", "text"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "contentType": { "type": "string" },
        "content_type": { "type": "string" },
        "text": { "type": "string" },
        "sourceId": { "type": "string" },
        "snapshotId": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "sourceIndexRef": { "$ref": "#/$defs/sourceIndexRef" }
      }
    },
    "corpusRun": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "consumer",
        "context_id",
        "prompt",
        "submitted_source_count",
        "included_source_count",
        "excluded_source_count",
        "decisions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "consumer": { "type": "string" },
        "context_id": { "type": "string" },
        "prompt": { "type": "string" },
        "workflow_version": { "type": "string" },
        "submitted_source_count": { "type": "number" },
        "included_source_count": { "type": "number" },
        "excluded_source_count": { "type": "number" },
        "common_themes": { "type": "array", "items": { "$ref": "#/$defs/metadata" } },
        "payload": { "$ref": "#/$defs/metadata" },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/sourceDecision" } },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "packetSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "decision", "snapshots", "evidence_refs"],
      "properties": {
        "source": { "$ref": "#/$defs/indexedSource" },
        "decision": { "$ref": "#/$defs/sourceDecision" },
        "snapshots": { "type": "array", "items": { "$ref": "#/$defs/sourceSnapshot" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "source_document": {
          "oneOf": [{ "$ref": "#/$defs/sourceDocument" }, { "type": "null" }]
        }
      }
    },
    "packetQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "includedSourceCount",
        "sourceDocumentCount",
        "snapshotCoverageRatio",
        "documentCoverageRatio",
        "evidenceCoverageRatio",
        "warningCount"
      ],
      "properties": {
        "status": { "enum": ["usable", "needs_review", "empty"] },
        "includedSourceCount": { "type": "number", "minimum": 0 },
        "sourceDocumentCount": { "type": "number", "minimum": 0 },
        "snapshotCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "documentCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "warningCount": { "type": "number", "minimum": 0 }
      }
    }
  }
}
