{
  "name": "lycium-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "corepack pnpm dev:web",
    "dev:web": "corepack pnpm --filter @lycium/web dev",
    "dev:api": "cd services/lycium-api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:worker": "cd services/lycium-workers && LYCIUM_API_URL=http://127.0.0.1:8000 lycium-worker --once",
    "dev:all": "concurrently -n web,api -c blue,green \"corepack pnpm dev:web\" \"corepack pnpm dev:api\"",
    "build": "corepack pnpm build:web",
    "build:web": "corepack pnpm --filter @lycium/web build",
    "test:contracts": "corepack pnpm --filter @lycium/contracts test",
    "test:api": "cd services/lycium-api && pytest -q",
    "validate": "corepack pnpm test:contracts && corepack pnpm --filter @lycium/web typecheck && corepack pnpm --filter @lycium/web build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.3.3"
  }
}
