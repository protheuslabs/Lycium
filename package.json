{
  "name": "lycium-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "corepack pnpm dev:all",
    "dev:web": "corepack pnpm --filter @lycium/web dev",
    "dev:api": "cd services/lycium-api && python3 -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:source-index": "cd services/source-index && PYTHONPATH=src python3 -m uvicorn source_index.main:app --reload --host 0.0.0.0 --port 8100",
    "dev:worker": "cd services/lycium-workers && LYCIUM_API_URL=http://127.0.0.1:8000 lycium-worker --once",
    "dev:all": "concurrently -n web,api -c blue,green \"corepack pnpm dev:web\" \"corepack pnpm dev:api\"",
    "build": "corepack pnpm build:web",
    "build:web": "corepack pnpm --filter @lycium/web build",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:readiness": "node scripts/check-professional-readiness.mjs",
    "docs:contracts": "corepack pnpm --filter @lycium/contracts docs:schemas",
    "check:docs": "corepack pnpm --filter @lycium/contracts docs:schemas:check",
    "verify:pages-export": "node scripts/verify-pages-export.mjs",
    "test:contracts": "corepack pnpm --filter @lycium/contracts test",
    "test:api": "cd services/lycium-api && python3 -m pytest -q",
    "test:program-evals": "cd services/lycium-api && python3 -m pytest tests/test_program_generation_eval_scenarios.py -q",
    "test:generation-evals": "cd services/lycium-api && python3 -m pytest tests/test_generation_eval_reports.py tests/test_course_generation_scenarios.py tests/test_program_generation_eval_scenarios.py -q",
    "report:generation-evals": "cd services/lycium-api && python3 scripts/write_generation_eval_report.py",
    "test:source-index": "cd services/source-index && python3 -m pytest -q",
    "test:workers": "cd services/lycium-workers && PYTHONPATH=src pytest -q",
    "test:e2e": "corepack pnpm --filter @lycium/web e2e",
    "check:loc": "node scripts/check-loc.mjs",
    "validate": "corepack pnpm check:loc && corepack pnpm check:boundaries && corepack pnpm check:data-boundaries && corepack pnpm check:readiness && corepack pnpm test:contracts && corepack pnpm --filter @lycium/web typecheck && corepack pnpm --filter @lycium/web build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "report:web-export": "node scripts/report-web-export.mjs",
    "check:data-boundaries": "node scripts/check-data-boundaries.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.3.3"
  }
}
