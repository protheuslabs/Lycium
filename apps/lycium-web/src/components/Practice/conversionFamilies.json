      "length": { "generator": "integer", "min": 100, "max": 5000 },
      "hundred": { "generator": "constant", "value": 100 },
      "thousand": { "generator": "constant", "value": 1000 },
      "one": { "generator": "constant", "value": 1 }
    },
    "derived": {
      "millimeters": { "operation": "multiply", "operands": ["length", 10] }
    },
    "presentation": {
      "prompt": "Convert {length} centimeters to millimeters using conversion factors.",
      "equation": ""
    },
    "interactions": [{
      "id": "conversion",
      "type": "conversion-chain",
      "prompt": "Set up your conversion",
      "start": { "value": "length", "unit": "cm", "species": "length" },
      "target": { "value": "millimeters", "unit": "mm", "species": "length", "decimals": 0 },
      "quantities": [
        { "id": "centimeters", "value": "hundred", "unit": "cm", "species": "length" },
        { "id": "meters", "value": "one", "unit": "m", "species": "length" },
        { "id": "millimeters", "value": "thousand", "unit": "mm", "species": "length" }
      ],
      "ratios": [["meters", "centimeters"], ["millimeters", "meters"]]
    }]
  },
  {
    "version": 3,
    "id": "electrical-energy-conversion",
    "category": "Engineering",
    "title": "Convert watt-hours to megajoules",
    "description": "Convert electrical energy through kilowatt-hours.",
    "variables": {
      "energy": { "generator": "integer", "min": 500, "max": 20000 },
      "thousand": { "generator": "constant", "value": 1000 },
      "one": { "generator": "constant", "value": 1 },
      "megajoulesPerKwh": { "generator": "constant", "value": 3.6 }
    },
    "derived": {
      "megajoules": { "operation": "multiply", "operands": [
        { "operation": "divide", "operands": ["energy", "thousand"] },
        "megajoulesPerKwh"
      ] }
    },
    "presentation": {
      "prompt": "Convert {energy} watt-hours of electrical energy to megajoules.",
      "equation": ""
    },
    "interactions": [{
      "id": "conversion",
      "type": "conversion-chain",
      "prompt": "Set up your energy conversion",
      "start": { "value": "energy", "unit": "Wh", "species": "energy" },
      "target": { "value": "megajoules", "unit": "MJ", "species": "energy", "decimals": 3 },
      "quantities": [
        { "id": "wattHours", "value": "thousand", "unit": "Wh", "species": "energy" },
        { "id": "kilowattHour", "value": "one", "unit": "kWh", "species": "energy" },
        { "id": "megajoules", "value": "megajoulesPerKwh", "unit": "MJ", "species": "energy" }
      ],
      "ratios": [["kilowattHour", "wattHours"], ["megajoules", "kilowattHour"]]
    }]
  }
]
