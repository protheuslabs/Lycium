[
  {
    "version": 3,
    "id": "stoichiometry-carbon-dioxide",
    "category": "Chemistry",
    "title": "Calculate carbon dioxide yield",
    "description": "Convert calcium carbonate mass to carbon dioxide mass.",
    "variables": {
      "sampleMass": { "generator": "decimal", "min": 10, "max": 200, "step": 0.1 },
      "reactantMolarMass": { "generator": "constant", "value": 100 },
      "productMolarMass": { "generator": "constant", "value": 44 },
      "one": { "generator": "constant", "value": 1 }
    },
    "derived": {
      "productMass": { "operation": "multiply", "operands": [
        { "operation": "divide", "operands": ["sampleMass", "reactantMolarMass"] },
        "productMolarMass"
      ] }
    },
    "presentation": {
      "prompt": "How many grams of carbon dioxide are produced when {sampleMass} g of calcium carbonate completely decomposes?",
      "equation": "CaCO₃ → CaO + CO₂"
    },
    "interactions": [{
      "id": "conversion",
      "type": "conversion-chain",
      "prompt": "Set up your calculation",
      "start": { "value": "sampleMass", "unit": "g", "species": "CaCO₃" },
      "target": { "value": "productMass", "unit": "g", "species": "CO₂", "decimals": 2 },
      "quantities": [
        { "id": "reactantMass", "value": "reactantMolarMass", "unit": "g", "species": "CaCO₃" },
        { "id": "reactantMoles", "value": "one", "unit": "mol", "species": "CaCO₃" },
        { "id": "productMoles", "value": "one", "unit": "mol", "species": "CO₂" },
        { "id": "productMass", "value": "productMolarMass", "unit": "g", "species": "CO₂" }
      ],
      "ratios": [
        ["reactantMoles", "reactantMass"],
        ["productMoles", "reactantMoles"],
        ["productMass", "productMoles"]
      ]
    }]
  },
  {
    "version": 3,
    "id": "metric-length-conversion",
    "category": "Mathematics",
    "title": "Convert centimeters to millimeters",
    "description": "Build a two-factor metric conversion.",
